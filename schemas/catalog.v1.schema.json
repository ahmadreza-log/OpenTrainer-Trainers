{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opentrainer:schema:catalog:1",
  "title": "OpenTrainer catalog",
  "description": "Generated by CI from games/ and manifests/. Never edit it by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "commit", "games", "trainers"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "commit": {
      "description": "The source commit, or null for a local build.",
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{40}$"
    },
    "games": {
      "type": "array",
      "items": { "$ref": "urn:opentrainer:schema:game:1" }
    },
    "trainers": {
      "type": "array",
      "items": { "$ref": "urn:opentrainer:schema:manifest:1" }
    }
  }
}
